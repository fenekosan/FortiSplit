### Sample openfortivpn config. Copy it, fill in your gateway and credentials,
### or import a ready-made config from the Settings window.
### Пример конфига openfortivpn. Заполни свои данные или импортируй готовый
### файл через окно настроек.

host = vpn.example.com
port = 443
username = user
password =

# Split tunnel: the gateway must not push routes or DNS — the app lays the
# routes down itself, from the list next to this file.
# Сплит-туннель: шлюзу не даём ставить маршруты и DNS, их кладёт приложение.
set-routes = 0
set-dns = 0

# On the first connection openfortivpn prints the gateway certificate hash.
# Paste it here to trust that gateway.
# При первом подключении openfortivpn напечатает хэш сертификата шлюза —
# впиши его сюда, чтобы шлюзу доверять.
# trusted-cert = <sha256>
