#!/bin/bash
# fortisplit-vpnctl — the only privileged entry point / единственная root-точка.
#
# Installed to /usr/local/bin (root:wheel, 0755) and allowed in
# /etc/sudoers.d/fortisplit with NOPASSWD. The GUI calls it via `sudo -n`.
#
# Configs and route lists live in the user's ~/.config/fortisplit and are edited
# by the app without root. Only what genuinely needs root happens here: starting
# openfortivpn and putting routes on the ppp interface.
#
# Routes are laid down by `apply-routes` rather than by an /etc/ppp/ip-up hook,
# so nothing of ours ends up in /etc/ppp and other PPP connections are left
# alone. The app calls it once the status turns CONNECTED and after the list is
# edited; repeating the call is harmless.
#
# Messages follow --lang=en|ru, else LANG/LC_ALL, else English.

set -uo pipefail

LOG="/var/log/fortisplit.log"

# Язык: флаг важнее окружения, потому что sudo окружение вычищает и LANG до нас
# может не доехать — приложение всегда передаёт --lang явно.
LANG_CODE=en
case "${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}" in ru*|RU*) LANG_CODE=ru ;; esac
case "${1:-}" in
    --lang=ru) LANG_CODE=ru; shift ;;
    --lang=*)  LANG_CODE=en; shift ;;
esac

t() {
    local k="$1" a="${2:-}"
    case "$LANG_CODE:$k" in
        ru:no-openfortivpn) echo "openfortivpn не найден. Установи: brew install openfortivpn" ;;
        en:no-openfortivpn) echo "openfortivpn not found. Install it: brew install openfortivpn" ;;
        ru:kind-config)     echo "конфиг" ;;
        en:kind-config)     echo "config" ;;
        ru:kind-routes)     echo "маршруты" ;;
        en:kind-routes)     echo "routes" ;;
        ru:need-abs)        echo "$a: нужен абсолютный путь" ;;
        en:need-abs)        echo "$a: absolute path required" ;;
        ru:no-dotdot)       echo "$a: '..' в пути не допускается" ;;
        en:no-dotdot)       echo "$a: '..' is not allowed in the path" ;;
        ru:no-symlink)      echo "$a: симлинк не допускается" ;;
        en:no-symlink)      echo "$a: symlinks are not allowed" ;;
        ru:not-found)       echo "$a: файл не найден" ;;
        en:not-found)       echo "$a: file not found" ;;
        ru:wrong-owner)     echo "$a: файл должен принадлежать вызывающему пользователю" ;;
        en:wrong-owner)     echo "$a: file must belong to the calling user" ;;
        ru:no-tunnel)       echo "туннель не поднят" ;;
        en:no-tunnel)       echo "the tunnel is not up" ;;
        ru:skipped)         echo "пропущены невалидные строки:" ;;
        en:skipped)         echo "skipped invalid lines:" ;;
        ru:usage-start)     echo "использование: fortisplit-vpnctl start <путь-к-конфигу>" ;;
        en:usage-start)     echo "usage: fortisplit-vpnctl start <config-path>" ;;
        ru:usage-apply)     echo "использование: fortisplit-vpnctl apply-routes <путь-к-маршрутам>" ;;
        en:usage-apply)     echo "usage: fortisplit-vpnctl apply-routes <routes-path>" ;;
        ru:usage-rest)      echo "                fortisplit-vpnctl {stop|status|logs}" ;;
        en:usage-rest)      echo "       fortisplit-vpnctl {stop|status|logs}" ;;
        ru:usage-lang)      echo "                общий флаг: --lang=en|ru перед командой" ;;
        en:usage-lang)      echo "       common flag: --lang=en|ru before the command" ;;
    esac
}

die() { echo "$1" >&2; exit "$2"; }

# openfortivpn ставится через brew: на Apple Silicon /opt/homebrew, на Intel /usr/local
OFV="$(command -v openfortivpn 2>/dev/null || true)"
[ -z "$OFV" ] && [ -x /opt/homebrew/bin/openfortivpn ] && OFV=/opt/homebrew/bin/openfortivpn
[ -z "$OFV" ] && [ -x /usr/local/bin/openfortivpn ] && OFV=/usr/local/bin/openfortivpn

# Путь приходит от GUI, а открывать его будет root. Полноценной защитой это не
# является (sudoers и так отдаёт root вызывающему), но отсекает случайности:
# только абсолютный путь, без '..', обычный файл, не симлинк, принадлежит тому,
# кто вызвал sudo.
check_user_file() {
    local p="$1" kind owner
    kind="$(t "kind-$2")"
    case "$p" in
        /*) ;;
        *) die "$(t need-abs "$kind")" 2 ;;
    esac
    case "$p" in
        *..*) die "$(t no-dotdot "$kind")" 2 ;;
    esac
    [ -L "$p" ] && die "$(t no-symlink "$kind"): $p" 2
    [ -f "$p" ] || die "$(t not-found "$kind"): $p" 4
    owner="$(stat -f %u "$p" 2>/dev/null)"
    if [ -n "${SUDO_UID:-}" ] && [ "$owner" != "$SUDO_UID" ]; then
        die "$(t wrong-owner "$kind")" 2
    fi
    return 0
}

ppp_iface() {
    # первый поднятый ppp-интерфейс, если есть
    ifconfig -l 2>/dev/null | tr ' ' '\n' | grep '^ppp' | head -n1
}

# Пид-файл не заводим: процесс однозначно опознаётся по своей командной строке.
is_running() {
    [ -n "$OFV" ] && pgrep -f "^$OFV -c " >/dev/null 2>&1
}

cmd="${1:-}"

case "$cmd" in
  start)
    config="${2:-}"
    [ -n "$OFV" ] || die "$(t no-openfortivpn)" 3
    [ -n "$config" ] || die "$(t usage-start)" 1
    if is_running; then echo "already running"; exit 0; fi
    check_user_file "$config" config
    : > "$LOG"
    # nohup + фон: процесс живёт независимо от sudo-сессии GUI
    nohup "$OFV" -c "$config" >> "$LOG" 2>&1 &
    echo "started"
    ;;

  stop)
    if is_running; then
        pkill -f "^$OFV -c " 2>/dev/null || true
        sleep 1
    fi
    echo "stopped"
    ;;

  status)
    IF="$(ppp_iface)"
    if [ -n "$IF" ] && is_running; then
        ip="$(ifconfig "$IF" 2>/dev/null | awk '/inet /{print $2; exit}')"
        printf "CONNECTED\t%s\n" "${ip:-$IF}"
    elif is_running; then
        printf "CONNECTING\t\n"
    else
        printf "DISCONNECTED\t\n"
    fi
    ;;

  apply-routes)
    routes="${2:-}"
    [ -n "$routes" ] || die "$(t usage-apply)" 1
    check_user_file "$routes" routes
    IF="$(ppp_iface)"
    [ -n "$IF" ] || die "$(t no-tunnel)" 4

    added=0; bad=""
    # `|| [ -n "$line" ]` — иначе последняя строка без перевода строки теряется
    while IFS= read -r line || [ -n "$line" ]; do
        line="$(printf '%s' "$line" | tr -d '\r' | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
        [ -z "$line" ] && continue
        case "$line" in \#*) continue ;; esac
        # в `route` уходит только строгий IPv4-CIDR и ничего больше
        if printf '%s' "$line" | grep -Eq '^[0-9]{1,3}(\.[0-9]{1,3}){3}/[0-9]{1,2}$'; then
            # повторный add на уже проложенный маршрут просто вернёт ошибку —
            # поэтому команду можно звать сколько угодно раз
            /sbin/route -n add -net "$line" -interface "$IF" >/dev/null 2>&1
            added=$((added + 1))
        else
            bad="${bad}${line}"$'\n'
        fi
    done < "$routes"

    echo "applied $added -> $IF"
    if [ -n "$bad" ]; then
        printf '%s\n%s' "$(t skipped)" "$bad" >&2
        exit 2
    fi
    ;;

  logs)
    tail -n 200 "$LOG" 2>/dev/null || true
    ;;

  *)
    { t usage-start; t usage-apply; t usage-rest; t usage-lang; } >&2
    exit 1
    ;;
esac
